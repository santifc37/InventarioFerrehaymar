# ============================================================
# Variables de entorno — Inventario Ferrehaymar
#
# Este archivo se versiona y SOLO tiene valores ficticios.
# Para trabajar: copiar a `.env` (no se versiona) en la carpeta de
# cada app y completar con valores reales de DESARROLLO.
# En producción, estas variables se configuran en los paneles de
# Render y Vercel, nunca en el repositorio.
# ============================================================


# ---------- API (apps/api — se despliega en Render) ----------

NODE_ENV=development
PORT=4000

# Dominio(s) del frontend permitidos por CORS (separados por coma).
CORS_ORIGIN=http://localhost:3000

# Zona horaria del negocio.
BUSINESS_TIMEZONE=America/Bogota

# Supabase (usar el proyecto de DESARROLLO).
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# SECRETA. Solo en el servidor (Render). Nunca en el frontend, en Git
# ni en los registros. Da acceso total a la base de datos.
SUPABASE_SERVICE_ROLE_KEY=reemplazar-con-la-clave-service-role

# Autenticación (se usa desde la Fase 4).
APP_PASSWORD=reemplazar-con-una-contrasena-larga
SESSION_SECRET=reemplazar-con-una-cadena-aleatoria-de-32-o-mas-caracteres
SESSION_DAYS=30


# ---------- Web (apps/web — se despliega en Vercel) ----------

# Solo las variables NEXT_PUBLIC_* llegan al navegador:
# NUNCA poner aquí contraseñas ni claves.
NEXT_PUBLIC_API_URL=http://localhost:4000
