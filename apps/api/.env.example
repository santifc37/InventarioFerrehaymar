# API (apps/api) - variables teóricas para desarrollo local
# No se versionan valores reales. Completar en .env local.

NODE_ENV=development
PORT=4000

# CORS
CORS_ORIGIN=http://localhost:3000

# Zona horaria del negocio
BUSINESS_TIMEZONE=America/Bogota

# Supabase (proyecto desarrollo)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=reemplazar-con-la-clave-service-role

# Autenticación (Fase 4 - teórico)
APP_PASSWORD=reemplazar-con-una-contrasena-larga
SESSION_SECRET=reemplazar-con-una-cadena-aleatoria-de-32-o-mas-caracteres
SESSION_DAYS=30

